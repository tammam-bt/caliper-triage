{
  "name": "caliper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Caliper — assistive triage console. Symptom intake, medical media capture, model-assisted assessment.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @caliper/web",
    "dev:api": "npm run dev -w @caliper/api"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
