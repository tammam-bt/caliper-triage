{
  "name": "caliper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Caliper \u2014 assistive triage console. Symptom intake, medical media capture, model-assisted assessment.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @caliper/web",
    "dev:api": "npm run dev -w @caliper/api",
    "e2e": "npm run e2e -w @caliper/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "mongodb-memory-server@10.4.3": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.24.3": true
  }
}