{
  "name": "@caliper/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The Caliper console. React + Vite. Runs the real service handlers in-browser when no API is configured.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "embeddings": "tsx scripts/build-label-embeddings.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@caliper/core": "*",
    "@caliper/service": "*",
    "@fontsource-variable/faustina": "^5.1.1",
    "@fontsource-variable/public-sans": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@huggingface/transformers": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "vite": "^6.0.7"
  }
}