# Copy to .env. None of these are required to run the test suite.
PORT=4000
MONGODB_URI=mongodb://localhost:27017/caliper
JWT_SECRET=change-me-in-production-at-least-32-characters-long
CORS_ORIGIN=http://localhost:5173

# Inference provider: cv-heuristic (default, no network) | vision-llm
AI_PROVIDER=cv-heuristic

# Only read when AI_PROVIDER=vision-llm. Never sent to a browser.
OPENROUTER_API_KEY=
VISION_BASE_URL=https://openrouter.ai/api/v1
# Ordered fallback list. Free models are rate-limited unpredictably, so more than one is required.
VISION_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
