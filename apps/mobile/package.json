{
  "name": "@caliper/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Expo React Native client. Shares @caliper/core and the pipeline with the web console.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "bundle:check": "expo export --platform android --output-dir dist --no-minify"
  },
  "dependencies": {
    "@caliper/core": "*",
    "@caliper/service": "*",
    "expo": "^57.0.0",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-notifications": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "pako": "^2.1.0",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/pako": "^2.0.3",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "^57.0.7",
    "typescript": "~6.0.3"
  }
}
